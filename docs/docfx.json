{
  "metadata": [
    {
      "src": [
        {
          "files": ["DotNetDo.Core/DotNetDo.Core.csproj"],
          "src": "../"
        }
      ],
      "dest": "../artifacts/docs/api-raw",
      "properties": {
        "TargetFramework": "net10.0",
        "Configuration": "Release"
      },
      "noRestore": true,
      "outputFormat": "apiPage",
      "memberLayout": "samePage",
      "categoryLayout": "none"
    }
  ],
  "build": {
    "content": [
      {
        "files": ["**/*.{md,yml}"],
        "src": "../artifacts/docs/composed"
      }
    ],
    "output": "../artifacts/docs/site",
    "template": ["default", "modern", "template"],
    "sitemap": {
      "baseUrl": "https://soxtoby.github.io/DotNetDo/"
    },
    "globalMetadata": {
      "_appName": "DotNet",
      "_appTitle": "DotNetDo",
      "_appFaviconPath": "public/favicon.svg",
      "_enableSearch": true,
      "_disableContribution": true,
      "_disableToc": false
    }
  }
}
